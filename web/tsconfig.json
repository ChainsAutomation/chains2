{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "preserve", "jsxImportSource": "@solidjs/web", "strict": true,
    "noEmit": true, "isolatedModules": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true
  },
  "include": ["src", "vite.config.ts", "playwright.config.ts", "tests"]
}
